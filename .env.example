# Supabase → Project Settings → API. La publishable key es pública (se usa en el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Demo local exclusivamente para desarrollo. Requiere además ?demo=1 y host localhost/127.0.0.1.
NEXT_PUBLIC_DEMO_LOCAL_ACCESS=0
